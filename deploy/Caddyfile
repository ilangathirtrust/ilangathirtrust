# Ilangathir Trust — Production Caddy Configuration (Auto-HTTPS)
# Domain architecture:
# - ilangathirtrust.org -> 301 redirect to https://www.ilangathirtrust.org
# - www.ilangathirtrust.org -> Next.js public web app (port 3000)
# - admin.ilangathirtrust.org -> Vite React admin SPA (static dist)
# - api.ilangathirtrust.org -> Express API server (port 4000)

ilangathirtrust.org {
	redir https://www.ilangathirtrust.org{uri} permanent
}

www.ilangathirtrust.org {
	encode zstd gzip
	reverse_proxy 127.0.0.1:3000
}

admin.ilangathirtrust.org {
	encode zstd gzip
	root * /var/www/ilangathirtrust/apps/admin/dist
	try_files {path} /index.html
	file_server
	header {
		X-Frame-Options "DENY"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "strict-origin-when-cross-origin"
	}
}

api.ilangathirtrust.org {
	encode zstd gzip
	reverse_proxy 127.0.0.1:4000
}
