# ==========================================================
# Ilangathir Trust — Environment Configuration Template
# Copy to .env and fill in real credentials. Never commit .env.
# ==========================================================

NODE_ENV=development

# Domain & Subdomain Architecture
ROOT_DOMAIN=ilangathirtrust.org
PUBLIC_SITE_URL=http://localhost:3000
ADMIN_SITE_URL=http://localhost:3001
API_SITE_URL=http://localhost:4000
API_PORT=4000

# CORS Allowed Origins (comma-separated)
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3001,https://www.ilangathirtrust.org,https://admin.ilangathirtrust.org,https://ilangathirtrust.org,https://ilangathir-web.vercel.app,https://ilangathir-admin.vercel.app

# Supabase Configuration (Primary Backend: DB, Auth, Storage)
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# Public Website (Next.js)
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:4000
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key
NEXT_PUBLIC_RAZORPAY_KEY_ID=rzp_test_your_key_id
NEXT_PUBLIC_GA4_MEASUREMENT_ID=G-XXXXXXXXXX

# Admin Panel (Vite)
VITE_API_URL=http://localhost:4000
VITE_PUBLIC_SITE_URL=http://localhost:3000
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key

# Razorpay Server Secrets (NEVER expose in frontend)
RAZORPAY_KEY_ID=rzp_test_your_key_id
RAZORPAY_KEY_SECRET=your_razorpay_key_secret
RAZORPAY_WEBHOOK_SECRET=your_razorpay_webhook_secret

# Media Upload & Caching Limits (Supabase Free Plan Friendly)
MAX_UPLOAD_IMAGE_MB=10
MAX_UPLOAD_VIDEO_MB=50
API_CACHE_TTL_SECONDS=300
